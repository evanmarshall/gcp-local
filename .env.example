# Local sandbox configuration. Copy to .env; never put tokens or JSON keys here.
# Required to create/link the test project:
GCP_PROJECT_ID=
GCP_BILLING_ACCOUNT_ID=
GCP_SETUP_ACCOUNT=

# Optional parent: set either an organization ID or a folder ID, not both.
GCP_ORGANIZATION_ID=
GCP_FOLDER_ID=
GCP_REGION=us-central1

# Desired monthly budget-alert amount in USD (not an enforced spending cap).
GCP_TEST_BUDGET_USD=
# Describe allowed resources and limits, e.g. Storage only, one bucket, tiny objects,
# no retained data. Cloud runs still require the explicit --gcp-allow-live flag.
GCP_TEST_LIVE_SCOPE=

# Filled after the project/identity setup. Path to ADC, not credential contents.
GCP_TEST_SERVICE_ACCOUNT=
GCP_TEST_CREDENTIALS_FILE=

# Synthetic local target, kept separate from the real sandbox project.
# This endpoint is configuration for the future emulator, not a working service.
GCP_LOCAL_PROJECT_ID=gcp-local-test
GCP_LOCAL_ENDPOINT=http://127.0.0.1:4566
