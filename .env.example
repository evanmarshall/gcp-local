# Local sandbox configuration. Copy to .env; never put tokens or JSON keys here.
# Required to create/link the test project:
GCP_PROJECT_ID=
# Filled after project creation (the immutable numeric project identifier).
GCP_PROJECT_NUMBER=
GCP_BILLING_ACCOUNT_ID=
GCP_SETUP_ACCOUNT=

# Optional parent: set either an organization ID or a folder ID, not both.
GCP_ORGANIZATION_ID=
GCP_FOLDER_ID=
GCP_REGION=us-central1

# Optional monthly budget-alert amount in USD (not an enforced spending cap).
GCP_TEST_BUDGET_USD=
# Describe allowed resources and limits, e.g. Storage only, one bucket, tiny objects,
# no retained data. Cloud runs still require the explicit --gcp-allow-live flag.
GCP_TEST_LIVE_SCOPE=

# Filled after the project/identity setup. Path to ADC, not credential contents.
GCP_TEST_SERVICE_ACCOUNT=
GCP_TEST_CREDENTIALS_FILE=
GCP_TEST_FIXTURE_SERVICE_ACCOUNT=
GCP_TEST_FIXTURE_CREDENTIALS_FILE=
GCP_TEST_DENIED_SERVICE_ACCOUNT=
GCP_TEST_DENIED_CREDENTIALS_FILE=
# Storage runner bounds; these may be lowered but not raised for the initial suite.
GCP_TEST_MAX_BUCKETS=1
GCP_TEST_MAX_OBJECTS=10
GCP_TEST_MAX_OBJECT_BYTES=1048576

# Synthetic local target, kept separate from the real sandbox project.
# This endpoint is configuration for the future emulator, not a working service.
GCP_LOCAL_PROJECT_ID=gcp-local-test
GCP_LOCAL_ENDPOINT=http://127.0.0.1:4566

# Optional: a separately authorized, unbilled peer project for #24 isolation tests.
# The peer has no Storage grant on GCP_PROJECT_ID. Its ADC uses the primary quota project.
GCP_TEST_PEER_PROJECT_ID=
GCP_TEST_PEER_SERVICE_ACCOUNT=
GCP_TEST_PEER_CREDENTIALS_FILE=
